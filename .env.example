# Copy this value into Xcode:
# Product → Scheme → Edit Scheme → Run → Arguments → Environment Variables
#
# Do not commit the real database path or a real .env file.
GEMLIFE_ENVIRONMENT=dev
# Required only for an explicitly approved PROD migration.
GEMLIFE_PROD_MIGRATION_ENABLED=false
DATABASE_PATH=/absolute/path/to/your/database.sqlite
DATABASE_PATH_FIT=/absolute/path/to/GemLife_DB_fit.sqlite
DATABASE_PATH_PROD=/absolute/path/to/GemLife_DB_prod.sqlite
ASSET_DIRECTORY=/absolute/path/to/your/local-assets
ASSET_MAX_BYTES=10485760

# Optional: enable safe local database creation from the React testing console.
# The directory must already exist and must not contain the personal database.
LOCAL_DATABASE_CREATION_ENABLED=false
LOCAL_DATABASE_DIRECTORY=/absolute/path/to/local/test-databases

# Optional: directory for backups created before an approved live schema change.
# The directory must already exist and should be separate from the database file.
LIVE_DATABASE_BACKUP_DIRECTORY=/absolute/path/to/database-backups
LIVE_DATABASE_BACKUP_DIRECTORY_FIT=/absolute/path/to/database-backups/fit
LIVE_DATABASE_BACKUP_DIRECTORY_PROD=/absolute/path/to/database-backups/prod
