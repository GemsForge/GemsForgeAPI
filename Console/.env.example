# Create a Geoapify project, then restrict the API key to the app's web origins.
# Copy this file to .env.local and replace the placeholder. Never commit a real key.
VITE_GEOAPIFY_API_KEY=replace-with-domain-restricted-geoapify-api-key
 # The API target should match API_PORT when running the Console independently.
VITE_API_TARGET=http://127.0.0.1:8180
